{
  "schemaVersion": 1,
  "id": "pi.advisor",
  "name": "Advisor",
  "version": "1.0.0",
  "description": "A second opinion the model can request from a stronger reviewer before it acts.",
  "author": "PI-Desktop",
  "main": "main.js",
  "ui": {
    "panel": "renderer/index.html",
    "width": 420,
    "height": 520,
    "title": {
      "en": "Advisor",
      "zh-CN": "顾问"
    }
  },
  "contributes": {
    "commands": [
      {
        "id": "advisor",
        "title": "Advisor: pick reviewer",
        "keywords": ["advisor", "reviewer", "second opinion", "顾问"],
        "category": "Agent"
      }
    ],
    "agentTools": [
      {
        "name": "advisor",
        "description": "Ask a stronger reviewer model for a plan, a correction, or a stop signal. Takes no parameters; the host forwards the current conversation.",
        "risk": "medium",
        "schema": {
          "type": "object",
          "properties": {}
        }
      }
    ],
    "skills": ["./skills/advisor.md"],
    "settings": [
      {
        "key": "modelKey",
        "type": "string",
        "default": "",
        "title": "Reviewer model",
        "description": "providerId/modelId. Set by /advisor."
      },
      {
        "key": "effort",
        "type": "select",
        "default": "high",
        "title": "Reviewer effort",
        "enum": [
          { "label": "Off (no reasoning)", "value": "off" },
          { "label": "minimal", "value": "minimal" },
          { "label": "low", "value": "low" },
          { "label": "medium", "value": "medium" },
          { "label": "high (recommended)", "value": "high" },
          { "label": "xhigh", "value": "xhigh" },
          { "label": "max", "value": "max" }
        ]
      },
      {
        "key": "disabledForModels",
        "type": "json",
        "default": [],
        "title": "Disable for executor models",
        "description": "Strings (providerId/modelId) or { \"model\", \"minEffort\" } objects."
      }
    ]
  },
  "permissions": [
    "ui.panel",
    "agent.tool.register",
    "agent.prompt.inject",
    "models.list",
    "session.read",
    "agent.complete"
  ],
  "engines": {
    "piDesktop": ">=0.8.0"
  },
  "enabledByDefault": false
}
