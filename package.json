{
  "name": "pi-desktop",
  "private": true,
  "version": "0.15.8",
  "description": "Local-first AI coding agent desktop client",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.19.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm --filter @pi-desktop/desktop dev",
    "preview": "pnpm --filter @pi-desktop/desktop run preview",
    "pack": "pnpm --filter @pi-desktop/desktop run pack",
    "dist": "pnpm --filter @pi-desktop/desktop run dist",
    "pi-plugin": "pi-plugin",
    "build": "pnpm -r --if-present build && cargo build --release -p host-core",
    "build:js": "pnpm -r --if-present build",
    "build:host": "cargo build --release -p host-core",
    "typecheck": "pnpm -r --if-present build && pnpm -r --if-present typecheck",
    "test": "pnpm build:js && pnpm -r --if-present test && cargo test -p host-core",
    "test:host": "cargo test -p host-core",
    "test:e2e": "node scripts/e2e-smoke.mjs",
    "test:e2e:scheduled": "node scripts/e2e-scheduled.mjs",
    "test:e2e:keep-awake": "node scripts/e2e-keep-awake.mjs",
    "test:e2e:rpc-unicode": "node scripts/e2e-rpc-unicode.mjs",
    "test:e2e:plan": "node scripts/e2e-plan.mjs",
    "test:e2e:plan-ui": "node scripts/e2e-plan-ui.mjs",
    "test:e2e:theme-surfaces": "node scripts/e2e-theme-surfaces.mjs",
    "test:e2e:composer-occlusion": "node scripts/e2e-theme-surfaces.mjs --dock-mask-only",
    "test:e2e:composer-autocomplete": "node scripts/e2e-composer-autocomplete.mjs",
    "test:e2e:composer-paste": "node scripts/e2e-composer-paste.mjs",
    "test:e2e:transcript": "node scripts/e2e-transcript-render.mjs",
    "test:e2e:copy-tex": "node scripts/e2e-copy-tex.mjs",
    "test:e2e:transcript-disclosure": "node scripts/e2e-transcript-disclosure-anchor.mjs",
    "test:e2e:images": "node scripts/e2e-image-generation.mjs && node scripts/e2e-image-generation-ui.mjs && node scripts/e2e-image-chat.mjs",
    "test:e2e:provider-order": "node scripts/e2e-provider-order.mjs",
    "test:e2e:project-edit": "node scripts/e2e-project-edit.mjs",
    "test:e2e:provider-api-style": "node scripts/e2e-provider-api-style.mjs",
    "test:e2e:hosted-search": "node scripts/e2e-hosted-search.mjs",
    "test:e2e:oauth-retry": "node --test apps/desktop/test/anthropic-oauth-retry.test.mjs",
    "test:e2e:boot": "node scripts/e2e-electron-boot.mjs",
    "test:e2e:settings-scroll": "node scripts/e2e-settings-scroll.mjs",
    "test:e2e:config-sync": "node scripts/e2e-config-sync-multidevice.mjs",
    "test:e2e:layout": "node scripts/e2e-three-column-layout.mjs",
    "test:e2e:window-controls": "node scripts/e2e-window-controls.mjs",
    "test:e2e:work-panel-reorder": "node scripts/e2e-work-panel-reorder.mjs",
    "test:e2e:supervision": "node scripts/e2e-supervision.mjs",
    "test:e2e:subagents": "node scripts/e2e-subagents.mjs",
    "test:e2e:subagent-models": "node scripts/e2e-subagent-models.mjs",
    "check:marketplace": "node scripts/check-marketplace-catalog.mjs",
    "check:release-docs": "node scripts/check-release-docs.mjs",
    "check:agent-policy": "node scripts/check-agent-policy-sync.mjs",
    "check:pr-base": "node scripts/check-pr-base-main.mjs",
    "docs:dev": "pnpm --filter @pi-desktop/docs dev",
    "docs:build": "pnpm --filter @pi-desktop/docs build",
    "docs:preview": "pnpm --filter @pi-desktop/docs preview",
    "docs:check": "pnpm --filter @pi-desktop/docs check:locales && pnpm --filter @pi-desktop/docs check:docs",
    "lint": "pnpm lint:biome && pnpm -r --if-present lint",
    "host:dev": "cargo run -p host-core",
    "clean": "pnpm -r --if-present clean && cargo clean",
    "lint:biome": "biome lint",
    "test:e2e:mcp-market": "node scripts/e2e-mcp-market.mjs",
    "test:e2e:skill-market": "node scripts/e2e-skill-market.mjs",
    "test:e2e:capability-move": "node scripts/e2e-capability-move.mjs",
    "test:e2e:plugin-import-deps": "node scripts/e2e-plugin-import-deps.mjs",
    "test:e2e:trusted-extensions": "node scripts/e2e-trusted-extensions.mjs",
    "test:e2e:collaboration": "node scripts/e2e-session-collaboration.mjs",
    "test:e2e:session-completion": "node scripts/e2e-session-completion.mjs",
    "test:e2e:remote-host": "node scripts/e2e-remote-host.mjs",
    "test:e2e:shortcut-settings": "node scripts/test-shortcut-settings.mjs",
    "test:e2e:dialog-overflow": "node scripts/test-dialog-overflow.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@pi-desktop/plugin-devkit": "workspace:*"
  }
}
