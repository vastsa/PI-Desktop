#!/bin/bash
set -euo pipefail

base=$(cd -- "$(dirname -- "$0")/../libreoffice" && pwd -P)
export SAL_USE_VCLPLUGIN=svp SAL_ENABLE_FILE_LOCKING=1
libraries="$base/program:$base/lib"

# The host cleans this directory after the Bash runner exits, even on stop.
profiles=${PI_OFFICE_RUNTIME_PROFILES:?Office rendering requires a managed profile directory}
if [[ ${HOME:-} == "$profiles" ]]; then
  # Some user scripts bootstrap a desktop profile and then call soffice again.
  profile=$profiles
  installation=$profile/.config/libreoffice/4
else
  profile=$(mktemp -d "$profiles/impress.XXXXXXXX")
  installation=$profile/lo
fi
export HOME="$profile" XDG_CONFIG_HOME="$profile/.config" XDG_CACHE_HOME="$profile/.cache"
export XDG_DATA_HOME="$profile/.local/share" XDG_RUNTIME_DIR="$profile" GNUPGHOME="$profile/.gnupg"
mkdir -p -m 700 "$GNUPGHOME"

for arg; do
  case "$arg" in
    -env:UserInstallation=*)
      LD_LIBRARY_PATH="$libraries" exec "$base/program/oosplash" --headless --nologo --norestore --nodefault "$@"
      ;;
  esac
done
LD_LIBRARY_PATH="$libraries" exec "$base/program/oosplash" "-env:UserInstallation=file://$installation" --headless --nologo --norestore --nodefault "$@"
