#!/bin/bash
set -euo pipefail
runtime=$(cd -- "$(dirname -- "$0")/.." && pwd -P)
profiles=${PI_OFFICE_RUNTIME_PROFILES:?Enable Office Runtime for this session}
timeout=$runtime/libexec/timeout
if [[ ! -f $timeout || ! -x $timeout ]]; then
  printf 'Office Runtime is incomplete: %s. Reinstall Pie Code or turn off Office Runtime in Extensions.\n' "$timeout" >&2
  exit 1
fi
profile=$(mktemp -d "$profiles/python.XXXXXXXX")
export HOME="$profile" PI_OFFICE_RUNTIME_PROFILES="$profile"
export PATH="$runtime/libexec:$runtime/bin:$PATH"
exec "$runtime/python/bin/python" "$@"
