{
  "name": "@pi-desktop/acp-client",
  "version": "0.15.7-beta.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/resolve.test.ts test/acp-client.test.ts",
    "smoke": "node scripts/acp-smoke.ts",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@pi-desktop/shared": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}

