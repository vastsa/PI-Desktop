@@ -0,0 +1,38 @@
+const messages = {
+    "context-validation": "Local request context validation failed",
+    "context-estimation": "Local request context estimation failed",
+    "request-preparation": "Local request preparation failed",
+};
+export class LocalRequestError extends Error {
+    code = "LOCAL_REQUEST_ERROR";
+    constructor(phase, options) {
+        // Expose only fixed descriptions; retain original data and underlying errors in cause.
+        super(messages[phase], options);
+        this.name = "LocalRequestError";
+        this.phase = phase;
+    }
+}
+export function localRequestErrorDetails(error) {
+    // Explicit markers work across packages/realms; never infer origin from TypeError, text, or absent responses.
+    if (!error || typeof error !== "object" || error.code !== "LOCAL_REQUEST_ERROR" ||
+        !Object.hasOwn(messages, error.phase))
+        return undefined;
+    return {
+        code: "LOCAL_REQUEST_ERROR",
+        phase: error.phase,
+        message: messages[error.phase],
+        ...(error.cause instanceof Error ? { causeName: error.cause.name } :
+            typeof error.causeName === "string" ? { causeName: error.causeName } : {}),
+    };
+}
+export function asLocalRequestError(error, phase) {
+    return localRequestErrorDetails(error) ? error : new LocalRequestError(phase, { cause: error });
+}
+export function prepareLocalRequest(phase, prepare) {
+    try {
+        return prepare();
+    }
+    catch (error) {
+        throw asLocalRequestError(error, phase);
+    }
+}
