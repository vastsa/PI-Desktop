+                requireValid(wire.type === undefined || wire.type === "web_search_tool_result" || wire.type === "web_search_tool_result_error");
+                requireValid(wire.tool_use_id === undefined || nonempty(wire.tool_use_id));
+                requireValid(wire.content !== undefined);
+                requireValid(value.isError === undefined || typeof value.isError === "boolean");
+                validateJson(wire);
