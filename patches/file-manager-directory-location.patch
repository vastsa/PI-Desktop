+/**
+ * 宿主打开目标在树里的身份（0.9.2 目录 location）。宿主引用的目录本就存在，
+ * 打开它意味着展开并列出内容，而不是把目录塞给文件读取（fm.read 对目录一律
+ * 报 INVALID_PATH）。判定只信**已经加载**的父目录列表：按 path 精确匹配条目。
+ * 列表缺席（还没列完 / 刚被外部改动）返回 "unknown"，调用方按文件处理——读
+ * 失败的报告本来就是准确的，宁可保守也不猜。
+ */
+export type HostOpenTargetKind = "file" | "directory" | "unknown";
+
+export function classifyHostOpenTarget(
+  relPath: string,
+  listing: readonly { path: string; isDirectory: boolean }[] | undefined,
+): HostOpenTargetKind {
+  const entry = listing?.find((candidate) => candidate.path === relPath);
+  if (!entry) return "unknown";
+  return entry.isDirectory ? "directory" : "file";
+}
+
 /**
  * 订阅两条投递路径，把去重后的请求交给 onRequest。返回取消函数。
  */
