index 0000000..dd5ef64
--- /dev/null
+++ b/views-src/verify-host-open.mjs
@@ -0,0 +1,114 @@
+/**
+ * 宿主打开目录 location（0.9.2）的离线校验。
+ *
+ * 宿主（Desktop 的 chat 面板）引用的目录以前也被塞给 fm.read，主进程一律回
+ * INVALID_PATH "path is a directory"，视图只能显示一句裸英文——目录引用等于
+ * 一个必然失败的操作。修好之后视图在父目录列表里判定身份：目录 → 展开并列出
+ * 内容；文件 → 照旧预览；列表缺席 → 按文件保守处理。这里断言 lib/hostOpen.ts
+ * 的纯判定与 lib/rpc.ts 对该失败的翻译，不需要 DOM（与 verify-roots.mjs 同样
+ * 的做法）。
+ *
+ * 用法：pnpm verify:host-open
+ */
+
+import { build } from "esbuild";
+import { mkdtempSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { dirname, join } from "node:path";
+import { fileURLToPath, pathToFileURL } from "node:url";
+
+const here = dirname(fileURLToPath(import.meta.url));
+
+async function loadModules(specifiers) {
+  const dir = mkdtempSync(join(tmpdir(), "pifm-host-open-"));
+  const entry = join(dir, "entry.ts");
+  const out = join(dir, "bundle.mjs");
+  const exports = specifiers
+    .map(([name, file]) => `import * as ${name} from ${JSON.stringify(join(here, "src", file))};\nexport { ${name} };`)
+    .join("");
+  writeFileSync(entry, exports);
+
+  await build({
+    entryPoints: [entry],
+    bundle: true,
+    format: "esm",
+    platform: "node",
+    outfile: out,
+    logLevel: "silent",
+  });
+
+  return import(pathToFileURL(out).href);
+}
+
+let failures = 0;
+function check(label, condition, detail = "") {
+  if (condition) {
+    console.log(`ok   ${label}`);
+    return;
+  }
+  failures += 1;
+  console.log(`FAIL ${label} ${detail}`);
+}
+
+const { hostOpen, rpc, i18n } = await loadModules([
+  ["hostOpen", join("lib", "hostOpen.ts")],
+  ["rpc", join("lib", "rpc.ts")],
+  ["i18n", join("i18n.ts")],
+]);
+
+const LISTING = [
+  { path: "examples", isDirectory: true },
+  { path: "test.ts", isDirectory: false },
+  { path: "src/dir/openimage.js", isDirectory: false },
+];
+
+console.log("1. classifyHostOpenTarget（父目录列表已加载）");
+check(
+  "目录条目判定为 directory",
+  hostOpen.classifyHostOpenTarget("examples", LISTING) === "directory",
+);
+check(
+  "文件条目判定为 file",
+  hostOpen.classifyHostOpenTarget("test.ts", LISTING) === "file",
+);
+check(
+  "多段路径按完整相对路径精确匹配，不做后缀猜测",
+  hostOpen.classifyHostOpenTarget("src/dir/openimage.js", LISTING) === "file" &&
+    hostOpen.classifyHostOpenTarget("dir/openimage.js", LISTING) === "unknown",
+);
+check(
+  "列表缺席（未加载 / 已失效）按 unknown 保守处理",
+  hostOpen.classifyHostOpenTarget("examples", undefined) === "unknown" &&
+    hostOpen.classifyHostOpenTarget("examples", []) === "unknown",
+);
+
+console.log("2. failureMessage 把目录读取失败翻成人话");
+const t = (key) => {
+  const table = {
+    errIsDirectory: "That path is a directory; folders are browsed in the tree, and only inside the project.",
+  };
+  return table[key] ?? key;
+};
+check(
+  'fm.read 的 INVALID_PATH "path is a directory" 得到专门文案',
+  rpc.failureMessage({ ok: false, code: "INVALID_PATH", message: "path is a directory" }, t) ===
+    t("errIsDirectory"),
+);
+check(
+  "其他 INVALID_PATH 仍返回主进程自己的 message",
+  rpc.failureMessage({ ok: false, code: "INVALID_PATH", message: "path must be a string" }, t) ===
+    "path must be a string",
+);
+
+console.log("3. 中英文案键一一对齐（errIsDirectory 两边都有）");
+check(
+  "en 与 zh 都有 errIsDirectory",
+  typeof i18n.COPY_TABLES.en.errIsDirectory === "string" &&
+    typeof i18n.COPY_TABLES.zh.errIsDirectory === "string",
+);
+
+if (failures > 0) {
+  console.log(`\n${failures} check(s) failed`);
+  process.exit(1);
+}
+console.log("\nall checks passed");
